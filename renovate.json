{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/kubernetes/.+\\.ya?ml$/"],
      "matchStrings": ["repository:\\s+['\"]?(?<depName>[^'\"\\s]+)['\"]?\\s+tag:\\s+['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "**/z-unused/**"
      ],
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "kubernetes",
        "helm-values"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "kubernetes/**"
      ],
      "groupName": null,
      "separateMinorPatch": true,
      "commitMessageTopic": "{{{depName}}}",
      "commitMessagePrefix": "chore(deps):",
      "commitMessageExtra": "to {{{newValue}}}"
    }
  ]
}
